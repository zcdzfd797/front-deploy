{
  "name": "front-deploy",
  "version": "1.0.0",
  "description": "前端代码部署到服务器指定位置",
  "main": "server.js",
  "scripts": {
    "start": "node --openssl-legacy-provider server.js",
    "dev": "node --openssl-legacy-provider server.js",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build",
    "tauri:build:win": "npx tauri build --bundles nsis",
    "tauri:build:mac": "npx tauri build --bundles app,dmg"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "multer": "^1.4.5-lts.1",
    "ssh2": "^1.15.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  }
}
